# ============================================================
# Income Planner · variables de entorno (las lee el BACKEND)
# Copia este archivo a .env (local) o cárgalo en Railway → Variables.
# El frontend no usa variables de entorno.
# ============================================================

# ---------- OBLIGATORIAS en producción (NODE_ENV=production) ----------
# Cadena de conexión a PostgreSQL.
#   Local:   postgres://postgres:postgres@localhost:5432/income_planner
#   Railway: usa la referencia  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/income_planner

# Secreto para firmar los JWT. Genera uno con:  openssl rand -hex 32
# Sin esta variable el backend se detiene al arrancar en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---------- RECOMENDADAS ----------
# Entorno de ejecución. En producción activa las validaciones estrictas.
NODE_ENV=production

# ---------- OPCIONALES ----------
# Puerto HTTP. Railway lo inyecta solo; local por defecto 3000.
# PORT=3000

# true solo si tu PostgreSQL exige SSL (la URL interna de Railway NO lo requiere;
# la URL pública sí puede requerirlo).
# PGSSL=false

# Solo desarrollo: origen del frontend de Vite para habilitar CORS.
# En producción el backend sirve el frontend desde el mismo dominio, no hace falta.
# CORS_ORIGIN=http://localhost:5173
